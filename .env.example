# ATLAS Environment Configuration
# Copy this file to .env and fill in values as needed.

# Application
ENVIRONMENT=local
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Persistence (local SQLite)
ATLAS_DATABASE_PATH=data/atlas.db

# Workflow timing (seconds between step executions)
ATLAS_STEP_DELAY_SECONDS=0.05

# Planner backend: auto | adk | local
# - auto: use ADK when credentials are present, otherwise local fallback
# - adk: force Gemini/ADK (falls back if credentials missing)
# - local: force local development fallback (no Gemini calls)
PLANNER_BACKEND=auto

# --- Gemini / Google ADK (optional for local development) ---

# Google AI Studio API key (Gemini API)
# GOOGLE_API_KEY=your-api-key-here

# Use Vertex AI instead of AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Gemini model (use versioned model IDs)
GEMINI_MODEL=gemini-2.5-flash
