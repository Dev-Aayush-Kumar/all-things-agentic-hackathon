# ATLAS Environment Configuration
# Copy this file to .env and fill in values as needed.
# Never commit .env or service-account JSON files.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=false
ATLAS_RUNTIME_MODE=local
# ATLAS_RUNTIME_MODE=cloud
ATLAS_RUNTIME_ROLE=api
# ATLAS_RUNTIME_ROLE=worker

# Server (local). Cloud Run sets PORT automatically.
HOST=0.0.0.0
PORT=8000

# Optional explicit backend overrides (auto | sqlite|firestore, local|gcs, local|pubsub)
ATLAS_PERSISTENCE=auto
ATLAS_STORAGE=auto
ATLAS_DISPATCHER=auto

# ---------------------------------------------------------------------------
# Local persistence and storage (default when ATLAS_RUNTIME_MODE=local)
# ---------------------------------------------------------------------------
ATLAS_DATABASE_PATH=data/atlas.db
ATLAS_UPLOAD_DIR=data/uploads
ATLAS_UPLOAD_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# Google Cloud (required when ATLAS_RUNTIME_MODE=cloud)
# Use Application Default Credentials or the Cloud Run service identity.
# Do not place service-account JSON files in this repository.
# ---------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# ATLAS_FIRESTORE_DATABASE=(default)
# ATLAS_GCS_BUCKET=your-atlas-datasets-bucket
# ATLAS_GCS_PREFIX=datasets
# ATLAS_PUBSUB_TOPIC=atlas-missions
# ATLAS_PUBSUB_SUBSCRIPTION=atlas-missions-worker

# ---------------------------------------------------------------------------
# Workflow timing (seconds between generic step executions)
# ---------------------------------------------------------------------------
ATLAS_STEP_DELAY_SECONDS=0.05

# Durable execution (leases and attempts)
# ATLAS_WORKER_ID=local-dev
ATLAS_EXECUTION_LEASE_SECONDS=30
ATLAS_EXECUTION_HEARTBEAT_SECONDS=10
ATLAS_MAX_EXECUTION_ATTEMPTS=3

# Agent loop safety limits (dataset investigation missions)
ATLAS_AGENT_MAX_ITERATIONS=20
ATLAS_AGENT_MAX_TOOL_CALLS=24
ATLAS_AGENT_MAX_RUNTIME_SECONDS=120
ATLAS_TASK_MAX_ATTEMPTS=2
ATLAS_MAX_ACTIONS=4
ATLAS_ACTION_MAX_ATTEMPTS=2
ATLAS_MAX_MODEL_CALLS=16
ATLAS_MAX_SPECIALIST_TASKS=24
ATLAS_MAX_REPEATED_DECISIONS=2
ATLAS_MAX_EXTERNAL_INVOCATIONS=4

# ---------------------------------------------------------------------------
# External tools (model proposes; ATLAS executes)
# FETCH_URL is fail-closed: an empty domain allowlist authorizes nothing.
# Never put credentials, cookies, or proxy secrets here.
# ---------------------------------------------------------------------------
ATLAS_EXTERNAL_TOOLS_ENABLED=true
ATLAS_FETCH_URL_ENABLED=true
# Comma-separated hostnames. Subdomains of an entry are allowed.
# ATLAS_FETCH_ALLOWED_DOMAINS=example.com,docs.example.org
ATLAS_FETCH_ALLOWED_DOMAINS=
ATLAS_FETCH_ALLOWED_SCHEMES=https,http
ATLAS_FETCH_TIMEOUT_SECONDS=5
ATLAS_FETCH_MAX_BYTES=65536
ATLAS_FETCH_MAX_REDIRECTS=3
ATLAS_FETCH_EXCERPT_CHARS=800
# Loopback/private destinations stay rejected unless this is explicitly true
# AND the host is also on ATLAS_FETCH_ALLOWED_DOMAINS (tests/dev only).
ATLAS_FETCH_ALLOW_LOOPBACK=false

# ---------------------------------------------------------------------------
# Persistent memory (extracted after mission completion)
# Historical memory is advisory. Current evidence always wins.
# ---------------------------------------------------------------------------
ATLAS_MEMORY_ENABLED=true
ATLAS_MEMORY_MAX_RETRIEVAL=5
ATLAS_MEMORY_MAX_EXTRACT=8
ATLAS_MEMORY_MIN_CONFIDENCE=0.4
ATLAS_MEMORY_CONTENT_MAX_CHARS=800

# ---------------------------------------------------------------------------
# Strategy learning (evaluated after mission completion)
# Historical strategies are advisory. Current evidence always wins.
# One successful run stays below ATLAS_STRATEGY_MIN_CONFIDENCE.
# ---------------------------------------------------------------------------
ATLAS_STRATEGY_ENABLED=true
ATLAS_STRATEGY_MAX_RETRIEVAL=3
ATLAS_STRATEGY_MIN_CONFIDENCE=0.60

# ---------------------------------------------------------------------------
# Human-in-the-loop governance
# Historical memory/strategies cannot approve operations. Gemini cannot either.
# ---------------------------------------------------------------------------
ATLAS_GOVERNANCE_ENABLED=true
ATLAS_APPROVAL_TTL_SECONDS=3600

# Planner backend: auto | adk | local
# - auto: use ADK when credentials are present, otherwise local fallback
# - adk: force Gemini/ADK (falls back if credentials missing)
# - local: force local development fallback (no Gemini calls)
PLANNER_BACKEND=auto

# ---------------------------------------------------------------------------
# Gemini / Google ADK
# Hackathon requirement: Gemini 3.5 or newer. ATLAS never silently replaces
# the configured model with an older one.
# Outbound Gemini TLS uses the native OS trust store (truststore); you do not
# need to set SSL_CERT_FILE or disable verification.
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash

# Google AI Studio API key (Gemini API). Optional for local development.
# GOOGLE_API_KEY=your-api-key-here

# Use Vertex AI instead of AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
